FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Seoul \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        git \
        less \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        tmux \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/vibe-venv \
    && /opt/vibe-venv/bin/pip install --upgrade pip wheel setuptools \
    && /opt/vibe-venv/bin/pip install -r /app/requirements.txt

ENV PATH="/opt/vibe-venv/bin:${PATH}"

COPY . /app

CMD ["python", "run_paper.py"]

